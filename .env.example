# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Shows the restaurant's top Google reviews on the home page.
# 1. Google Cloud Console -> create/select a project -> enable "Places API (New)".
# 2. APIs & Services -> Credentials -> create an API key, restrict it to
#    "Places API (New)" (and to your server's IP if you can).
# 3. Paste it below and restart the dev server.
# Leave empty to hide the Google reviews (hand-written ones in
# src/data/reviews.ts are used instead, if any).
GOOGLE_PLACES_API_KEY=

# Optional: skips the automatic place lookup. Find it with Google's
# "Place ID Finder" (starts with ChIJ...).
GOOGLE_PLACE_ID=
